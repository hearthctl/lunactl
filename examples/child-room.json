{
  "schema": 1,
  "display": {
    "timeout": 10,
    "brightness": "input_number.lunactl_brightness"
  },
  "buttons": {
    "a_short": {"action": "script.lunactl_taste_a"},
    "b_long": {"action": "script.lunactl_papa_rufen"}
  },
  "pages": [
    {
      "type": "pie",
      "quarters": [
        {
          "label": "Hell",
          "icon": "mdi:white-balance-sunny",
          "color": "#D69319",
          "action": {
            "action": "scene.turn_on",
            "target": {"entity_id": "scene.kinderzimmer_hell"}
          }
        },
        {
          "label": "Lesen",
          "icon": "mdi:book-open-variant",
          "color": "#2876A8",
          "action": {
            "action": "scene.turn_on",
            "target": {"entity_id": "scene.kinderzimmer_lesen"}
          }
        },
        {
          "label": "Gemütlich",
          "icon": "mdi:sofa",
          "color": "#B85C20",
          "action": {
            "action": "scene.turn_on",
            "target": {"entity_id": "scene.kinderzimmer_gemuetlich"}
          }
        },
        {
          "label": "Schlafen gehen",
          "icon": "mdi:weather-night",
          "color": "#573382",
          "action": {
            "action": "scene.turn_on",
            "target": {"entity_id": "scene.kinderzimmer_schlafen_gehen"}
          }
        }
      ]
    },
    {
      "type": "dial",
      "status": {"format": "{0}", "refs": [{"entity": "sensor.kinderzimmer_klima_status"}]},
      "value": {"format": "{0}", "refs": [{"entity": "sensor.kinderzimmer_klima_wert"}]},
      "caption": {"format": "{0}", "refs": [{"entity": "sensor.kinderzimmer_klima_zeile"}]},
      "minus": {
        "label": "Kälter", "color": "#374151",
        "action": {"action": "script.lunactl_kaelter"},
        "active": {"entity": "climate.kinderzimmer", "attribute": "hvac_mode", "states": ["cool", "heat"]}
      },
      "plus": {
        "label": "Wärmer", "color": "#374151",
        "action": {"action": "script.lunactl_waermer"},
        "active": {"entity": "climate.kinderzimmer", "attribute": "hvac_mode", "states": ["cool", "heat"]}
      },
      "items": [
        {
          "label": "Kühlen", "icon": "mdi:snowflake", "color": "#3B82F6",
          "action": {"action": "script.lunactl_kuehlen"},
          "active": {"entity": "climate.kinderzimmer", "attribute": "hvac_mode", "states": ["cool"]}
        },
        {
          "label": "Aus", "icon": "mdi:power", "color": "#8A93A3",
          "action": {"action": "script.lunactl_klima_aus"},
          "active": {"entity": "climate.kinderzimmer", "attribute": "hvac_mode", "states": ["off"]}
        },
        {
          "label": "Heizen", "icon": "mdi:fire", "color": "#F0782A",
          "action": {"action": "script.lunactl_heizen"},
          "active": {"entity": "climate.kinderzimmer", "attribute": "hvac_mode", "states": ["heat"]}
        }
      ],
      "countdown": "timer.kinderzimmer_klima_lauf"
    },
    {
      "type": "single",
      "item": {
        "label": "Papa rufen",
        "icon": "mdi:hand-wave",
        "color": "#B91360",
        "action": {"action": "script.lunactl_papa_rufen"},
        "value": {
          "format": "{0}",
          "refs": [
            {"entity": "input_boolean.lunactl_papa_kommt", "map": {"on": "Papa kommt", "off": ""}}
          ]
        }
      }
    }
  ]
}
