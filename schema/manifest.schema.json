{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lunactl Manifest, schema 1 (single Item and keys)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "pages"],
  "properties": {
    "schema": {"type": "integer", "const": 1},
    "buttons": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "a_short": {"$ref": "#/$defs/action"},
        "a_long": {"$ref": "#/$defs/action"},
        "b_short": {"$ref": "#/$defs/action"},
        "b_long": {"$ref": "#/$defs/action"}
      }
    },
    "pages": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["type", "item"],
        "properties": {
          "type": {"const": "single"},
          "item": {"$ref": "#/$defs/item"}
        }
      }
    }
  },
  "$defs": {
    "selector": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      ]
    },
    "action": {
      "type": "object", "additionalProperties": false, "required": ["action"],
      "properties": {
        "action": {"type": "string", "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+$"},
        "target": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "entity_id": {"$ref": "#/$defs/selector"},
            "device_id": {"$ref": "#/$defs/selector"},
            "area_id": {"$ref": "#/$defs/selector"},
            "floor_id": {"$ref": "#/$defs/selector"},
            "label_id": {"$ref": "#/$defs/selector"}
          }
        },
        "data": {"type": "object"}
      }
    },
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["label", "color", "action"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
        "action": {"$ref": "#/$defs/action"}
      }
    }
  }
}
